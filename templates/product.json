{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "size_chart": {
          "type": "size_chart",
          "settings": {
            "label": "Size guide"
          }
        },
        "stock_bar": {
          "type": "stock_bar",
          "settings": {
            "threshold": 10,
            "show_quantity": true
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "wishlist": {
          "type": "wishlist",
          "settings": {}
        },
        "trust_badges": {
          "type": "trust_badges",
          "settings": {
            "caption": "Secure checkout with"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>Dispatched within 24 hours. Free returns within 30 days of delivery.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials & care",
            "icon": "washing",
            "content": "<p>Add fabric composition and washing instructions here.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "rating",
        "variant_picker",
        "size_chart",
        "stock_bar",
        "buy_buttons",
        "wishlist",
        "trust_badges",
        "description",
        "tab_shipping",
        "tab_care",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_to_show": 4,
        "minimum_products": 2
      }
    },
    "sticky-add-to-cart": {
      "type": "sticky-add-to-cart",
      "settings": {
        "visibility": "all",
        "button_action": "add_to_cart"
      }
    }
  },
  "order": [
    "main",
    "related-products",
    "recently-viewed",
    "sticky-add-to-cart"
  ]
}
