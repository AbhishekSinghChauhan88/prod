{% comment %}
  Renders one half of the header menu for the split-centered logo layout.

  Mirrors the markup of `header-dropdown-menu` so the existing disclosure
  behaviour, list-menu styles and keyboard handling all keep working — the only
  difference is that it draws a slice of the menu rather than all of it, and
  namespaces its ids by side so the two halves never collide.

  Accepts:
  - menu_links: {Array} the link list to slice
  - menu_offset: {Number} how many links to skip. Default: 0 (optional)
  - menu_limit: {Number} how many links to draw
  - menu_side: {String} "left" or "right", used for ids and alignment
  - menu_color_scheme: {String} color scheme for the submenus

  Usage:
  {% render 'header-split-menu', menu_links: menu.links, menu_offset: 0, menu_limit: 3, menu_side: 'left' %}
{% endcomment %}

{%- liquid
  assign side = menu_side | default: 'left'
  assign offset = menu_offset | default: 0
-%}

<nav class="header__inline-menu header__split header__split--{{ side }}">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in menu_links offset: offset limit: menu_limit -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ side }}-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ side }}-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ side }}-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ side }}-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ side }}-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ side }}-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ side }}-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ side }}-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ side }}-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
