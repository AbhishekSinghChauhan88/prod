{% comment %}
  Renders a single logo, wrapped in a link when the block has one.

  Accepts:
  - block: {Object} a `logo` block from the Logo list section

  Usage:
  {% render 'logo-list-item', block: block %}
{% endcomment %}

{%- liquid
  assign logo_alt = block.settings.image.alt | default: block.settings.name
-%}

{%- if block.settings.link != blank -%}
  <a href="{{ block.settings.link }}" class="logo-list__link">
{%- endif -%}

{%- if block.settings.image != blank -%}
  {{
    block.settings.image
    | image_url: width: 480
    | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 200px, 40vw', alt: logo_alt
  }}
{%- elsif block.settings.name != blank -%}
  <span class="logo-list__placeholder">{{ block.settings.name }}</span>
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'logo-list__placeholder-svg placeholder-svg' }}
{%- endif -%}

{%- if block.settings.link != blank -%}
  </a>
{%- endif -%}
