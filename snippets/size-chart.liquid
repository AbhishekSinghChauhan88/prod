{% comment %}
  Renders a size chart link that opens the chosen page's content in a modal.

  Reuses Dawn's own modal-opener / modal-dialog pair and the product popup
  styles, so focus trapping, keyboard handling and theming come for free.

  Accepts:
  - block: {Object} the `size_chart` block, for its settings

  Usage:
  {% render 'size-chart', block: block %}
{% endcomment %}

{%- if block.settings.page != blank -%}
  {%- assign chart_label = block.settings.label | default: block.settings.page.title -%}

  <modal-opener
    class="size-chart quick-add-hidden"
    data-modal="#SizeChartModal-{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    <button
      id="SizeChartButton-{{ block.id }}"
      class="size-chart__link"
      type="button"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper">
        {{- 'icon-ruler.svg' | inline_asset_content -}}
      </span>
      {{ chart_label | escape }}
    </button>
  </modal-opener>

  <modal-dialog id="SizeChartModal-{{ block.id }}" class="product-popup-modal">
    <div
      role="dialog"
      aria-label="{{ chart_label | escape }}"
      aria-modal="true"
      class="product-popup-modal__content"
      tabindex="-1"
    >
      <button
        id="ModalClose-{{ block.id }}"
        type="button"
        class="product-popup-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="product-popup-modal__content-info">
        <h2 class="h3">{{ block.settings.page.title | escape }}</h2>
        {{ block.settings.page.content }}
      </div>
    </div>
  </modal-dialog>
{%- endif -%}
