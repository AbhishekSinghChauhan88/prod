{% doc %}
  @prompt
    coming soon page with background and really good animations and aethetics, Liquid error (temp/ai_gen_block_0c8ebef line 343): Invalid form type "as3pmeelqndzuu2mxnaigenblock0c8ebefmlxqea", must be one of ["product", "storefront_password", "contact", "customer_login", "create_customer", "recover_customer_password", "reset_customer_password", "guest_login", "currency", "activate_customer_password", "customer_address", "new_comment", "customer", "localization", "cart"]-----fix this error
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coming-soon-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  .ai-coming-soon-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-coming-soon-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-coming-soon-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, {{ block.settings.gradient_color_1 }} 0%, {{ block.settings.gradient_color_2 }} 100%);
  }

  .ai-coming-soon-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
  }

  .ai-coming-soon-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-coming-soon-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 40px 20px;
    text-align: center;
  }

  .ai-coming-soon-logo-{{ ai_gen_id }} {
    margin-bottom: 40px;
    opacity: 0;
  }

  .ai-coming-soon-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-coming-soon-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    opacity: 0;
  }

  .ai-coming-soon-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 40px;
    max-width: 600px;
    line-height: 1.6;
    opacity: 0;
  }

  .ai-coming-soon-countdown-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    margin-bottom: 50px;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
  }

  .ai-coming-soon-countdown-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
  }

  .ai-coming-soon-countdown-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.countdown_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    line-height: 1;
    margin-bottom: 8px;
  }

  .ai-coming-soon-countdown-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ai-coming-soon-form-{{ ai_gen_id }} {
    width: 100%;
    max-width: 500px;
    opacity: 0;
  }

  .ai-coming-soon-form-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
  }

  .ai-coming-soon-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 16px 20px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .ai-coming-soon-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_text_color }};
    opacity: 0.6;
  }

  .ai-coming-soon-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-coming-soon-button-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-coming-soon-button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }

  .ai-coming-soon-message-{{ ai_gen_id }} {
    font-size: 14px;
    margin-top: 10px;
  }

  .ai-coming-soon-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-coming-soon-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  .ai-coming-soon-social-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    margin-top: 40px;
    opacity: 0;
  }

  .ai-coming-soon-social-link-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.social_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .ai-coming-soon-social-link-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
    background-color: {{ block.settings.button_bg_color }};
  }

  .ai-coming-soon-social-link-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.social_icon_color }};
  }

  @keyframes ai-fadeInUp-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-coming-soon-logo-{{ ai_gen_id }}.ai-animate-{{ ai_gen_id }} {
    animation: ai-fadeInUp-{{ ai_gen_id }} 1s ease forwards;
  }

  .ai-coming-soon-heading-{{ ai_gen_id }}.ai-animate-{{ ai_gen_id }} {
    animation: ai-fadeInUp-{{ ai_gen_id }} 1s ease 0.2s forwards;
  }

  .ai-coming-soon-subheading-{{ ai_gen_id }}.ai-animate-{{ ai_gen_id }} {
    animation: ai-fadeInUp-{{ ai_gen_id }} 1s ease 0.4s forwards;
  }

  .ai-coming-soon-countdown-{{ ai_gen_id }}.ai-animate-{{ ai_gen_id }} {
    animation: ai-fadeInUp-{{ ai_gen_id }} 1s ease 0.6s forwards;
  }

  .ai-coming-soon-form-{{ ai_gen_id }}.ai-animate-{{ ai_gen_id }} {
    animation: ai-fadeInUp-{{ ai_gen_id }} 1s ease 0.8s forwards;
  }

  .ai-coming-soon-social-{{ ai_gen_id }}.ai-animate-{{ ai_gen_id }} {
    animation: ai-fadeInUp-{{ ai_gen_id }} 1s ease 1s forwards;
  }

  @media screen and (max-width: 749px) {
    .ai-coming-soon-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-coming-soon-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-coming-soon-countdown-number-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.countdown_size }}px * 0.7);
    }

    .ai-coming-soon-countdown-{{ ai_gen_id }} {
      gap: 15px;
    }

    .ai-coming-soon-countdown-item-{{ ai_gen_id }} {
      min-width: 60px;
    }

    .ai-coming-soon-form-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<coming-soon-{{ ai_gen_id }} class="ai-coming-soon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coming-soon-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-coming-soon-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-coming-soon-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-coming-soon-content-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <div class="ai-coming-soon-logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="Logo"
          loading="eager"
          width="400"
          height="auto"
        >
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-coming-soon-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-coming-soon-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    {% if block.settings.show_countdown %}
      <div class="ai-coming-soon-countdown-{{ ai_gen_id }}">
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-countdown-days>00</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Days</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-countdown-hours>00</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Hours</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-countdown-minutes>00</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Minutes</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-countdown-seconds>00</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Seconds</div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_email_form %}
      <div class="ai-coming-soon-form-{{ ai_gen_id }}">
        {%- form 'contact' -%}
          <input type="hidden" name="contact[coming_soon]" value="true">
          <div class="ai-coming-soon-form-wrapper-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="ai-coming-soon-input-{{ ai_gen_id }}"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-coming-soon-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-coming-soon-success-{{ ai_gen_id }}"
              {% endif %}
              placeholder="{{ block.settings.email_placeholder }}"
              required
            >
            <button type="submit" class="ai-coming-soon-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
          <div class="ai-coming-soon-message-{{ ai_gen_id }}">
            {%- if form.errors -%}
              <div id="ai-coming-soon-error-{{ ai_gen_id }}" class="ai-coming-soon-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <div id="ai-coming-soon-success-{{ ai_gen_id }}" class="ai-coming-soon-success-{{ ai_gen_id }}">
                {{ block.settings.success_message }}
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    {% endif %}

    {% if block.settings.show_social %}
      <div class="ai-coming-soon-social-{{ ai_gen_id }}">
        {% if block.settings.facebook_url != blank %}
          <a href="{{ block.settings.facebook_url }}" class="ai-coming-soon-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Facebook">
