{% comment %}
  Renders a menu as a plain multi-column list of text links.

  Deliberately typographic: no tiles, no thumbnails. Where a category grid asks
  the shopper to look, this asks them to read, which suits a long list of
  departments far better than two dozen images would.
{% endcomment %}

{{ 'theme-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #CategoryLinks-{{ section.id }} .category-links__list {
    column-count: {{ section.settings.columns_mobile }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #CategoryLinks-{{ section.id }} .category-links__list {
      column-count: {{ section.settings.columns_desktop }};
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" id="CategoryLinks-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="category-links__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      <ul
        class="category-links__list list-unstyled{% if section.settings.uppercase %} category-links__list--uppercase{% endif %}"
        role="list"
      >
        {%- for link in section.settings.menu.links -%}
          <li class="category-links__item">
            <a
              href="{{ link.url }}"
              class="category-links__link link"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="category-links__empty">
        {{ 'Choose a menu in this section to list its links here.' }}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Category links",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lists a menu's links as plain text in columns. Pick a menu whose links point at your collections."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "default": false,
      "label": "Uppercase links"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Category links"
    }
  ]
}
{% endschema %}
