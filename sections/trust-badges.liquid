{{ 'theme-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title {{ section.settings.heading_size }} center">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul
      class="trust-badges trust-badges--{{ section.blocks.size | at_most: 5 }}{% if section.settings.alignment == 'center' %} trust-badges--centered{% endif %}"
      role="list"
    >
      {%- for block in section.blocks -%}
        <li
          class="trust-badge{% if section.settings.animate %} scroll-trigger animate--slide-in{% endif %}"
          {% if section.settings.animate %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="trust-badge__icon">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 96
                | image_tag: loading: 'lazy', alt: block.settings.image.alt
              }}
            {%- elsif block.settings.icon != 'none' -%}
              {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
            {%- endif -%}
          </span>
          <div>
            {%- if block.settings.title != blank -%}
              <p class="trust-badge__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="trust-badge__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "Extra small"
        },
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Icon beside text"
        },
        {
          "value": "center",
          "label": "Icon above text"
        }
      ],
      "default": "center",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "default": false,
      "label": "Animate on scroll"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "padlock",
              "label": "Padlock"
            },
            {
              "value": "chat-bubble",
              "label": "Chat bubble"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "recycle",
              "label": "Recycle"
            },
            {
              "value": "plane",
              "label": "Plane"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "price-tag",
              "label": "Price tag"
            },
            {
              "value": "stopwatch",
              "label": "Stopwatch"
            },
            {
              "value": "check-mark",
              "label": "Check mark"
            }
          ],
          "default": "truck",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Replaces the icon when set."
        },
        {
          "type": "text",
          "id": "title",
          "default": "Free shipping",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "default": "On all orders over $75",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        {
          "type": "badge"
        },
        {
          "type": "badge",
          "settings": {
            "icon": "return",
            "title": "30-day returns",
            "text": "No questions asked"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Encrypted end to end"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "chat-bubble",
            "title": "Real support",
            "text": "We reply within a day"
          }
        }
      ]
    }
  ]
}
{% endschema %}
