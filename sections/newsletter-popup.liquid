{{ 'theme-enhancements.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<newsletter-popup
  class="newsletter-popup"
  data-section-id="{{ section.id }}"
  data-delay="{{ section.settings.delay_seconds }}"
  data-dismiss-days="{{ section.settings.dismiss_days }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="NewsletterPopupHeading-{{ section.id }}"
>
  <button
    type="button"
    class="newsletter-popup__overlay"
    data-popup-close
    aria-label="{{ 'accessibility.close' | t }}"
    tabindex="-1"
  ></button>

  <div class="newsletter-popup__dialog color-{{ section.settings.color_scheme }} gradient{% if section.settings.image != blank %} newsletter-popup__dialog--with-image{% endif %}">
    <button type="button" class="newsletter-popup__close" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
      <span class="svg-wrapper">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </button>

    {%- if section.settings.image != blank -%}
      <div class="newsletter-popup__media">
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 310px, 0px', alt: section.settings.image.alt
        }}
      </div>
    {%- endif -%}

    <div class="newsletter-popup__body">
      <h2 id="NewsletterPopupHeading-{{ section.id }}" class="{{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>

      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="NewsletterPopup--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'newsletter.label' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="NewsletterPopup-error--{{ section.id }}"
              {% endif %}
            >
            <label class="field__label" for="NewsletterPopup--{{ section.id }}">
              {{ 'newsletter.label' | t }}
            </label>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="NewsletterPopup-error--{{ section.id }}">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>

        {%- if form.posted_successfully? -%}
          <h3 class="newsletter-form__message newsletter-form__message--success form__message" tabindex="-1">
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            {{- 'newsletter.success' | t }}
          </h3>
        {%- endif -%}
      {% endform %}

      {%- if section.settings.dismiss_label != blank -%}
        <button type="button" class="newsletter-popup__dismiss" data-popup-close>
          {{- section.settings.dismiss_label -}}
        </button>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <div class="rte caption">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
    </div>
  </div>
</newsletter-popup>

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The popup always shows while you are editing so you can style it. On the live store it appears once, then stays hidden for the number of days set below."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Get 10% off your first order",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Join the list for early access to new drops and members-only offers.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "default": "No thanks",
      "label": "Dismiss link label"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 6,
      "label": "Delay before showing"
    },
    {
      "type": "range",
      "id": "dismiss_days",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 14,
      "label": "Days to stay hidden after dismissal"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
