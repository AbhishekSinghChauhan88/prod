{% comment %}
  Brand story — one editorial split, image beside text.

  Closer to a magazine spread than an information block: a short headline, three
  short lines, one text link, and a lot of air around them.
{% endcomment %}

{{ 'editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'editorial.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<div class="color-{{ s.color_scheme }} gradient">
  <div class="ed-width ed-section">
    <div class="ed-split{% if s.layout == 'text_first' %} ed-split--text-first{% endif %}">
      <div class="ed-split__media ed-reveal" style="--ed-ratio: {{ s.image_ratio }};">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1800
            | image_tag:
              widths: '400, 600, 800, 1100, 1400, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'lazy',
              alt: s.image.alt | default: s.heading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="ed-split__text">
        {%- if s.label != blank -%}
          <p class="ed-label ed-reveal">{{ s.label | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="ed-display ed-display--sm ed-reveal" style="--ed-delay: 0.08s;">
            {{ s.heading }}
          </h2>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="ed-body ed-reveal" style="--ed-delay: 0.16s;">{{ s.text }}</div>
        {%- endif -%}

        {%- if s.cta_label != blank -%}
          <div class="ed-reveal" style="--ed-delay: 0.24s;">
            <a href="{{ s.cta_link | default: routes.root_url }}" class="ed-link">
              {{ s.cta_label | escape }}
              <span class="ed-link__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Tall" }
      ],
      "default": "4 / 5",
      "label": "Image shape"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image left" },
        { "value": "text_first", "label": "Image right" }
      ],
      "default": "image_first",
      "label": "Layout"
    },
    { "type": "text", "id": "label", "label": "Label" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Designed to last.",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Quality materials. Considered details. Nothing unnecessary.</p>",
      "label": "Text"
    },
    { "type": "text", "id": "cta_label", "default": "Our story", "label": "Link label" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
