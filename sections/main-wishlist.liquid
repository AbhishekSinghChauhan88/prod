{{ 'theme-enhancements.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <h1 class="title {{ section.settings.heading_size }}">
    {{ section.settings.heading | default: page.title }}
  </h1>

  {%- if section.settings.description != blank -%}
    <div class="rte">{{ section.settings.description }}</div>
  {%- endif -%}

  <wishlist-list data-card-section="wishlist-card">
    <div class="wishlist-loading center" data-wishlist-loading hidden>
      {%- render 'loading-spinner', class: 'loading__spinner' -%}
      <span class="visually-hidden">{{ 'wishlist.loading' | t }}</span>
    </div>

    <ul
      class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
      data-wishlist-grid
      role="list"
      hidden
    ></ul>

    <div class="wishlist-empty" data-wishlist-empty hidden>
      <p class="h3">{{ section.settings.empty_heading }}</p>
      {%- if section.settings.empty_text != blank -%}
        <div class="rte">{{ section.settings.empty_text }}</div>
      {%- endif -%}
      <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="button">
        {{- section.settings.empty_button_label | default: 'Continue shopping' -}}
      </a>
    </div>

    <div class="center">
      <button type="button" class="button button--secondary" data-wishlist-clear hidden>
        {{- 'wishlist.clear' | t -}}
      </button>
    </div>
  </wishlist-list>
</div>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Your wishlist",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Products you save are kept on this device.</p>",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "label": "t:sections.featured-collection.settings.columns_mobile.label"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "default": "Nothing saved yet",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "default": "<p>Tap the heart on any product to save it for later.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "default": "Start shopping",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ]
}
{% endschema %}
