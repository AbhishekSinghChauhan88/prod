{% comment %}
  Full-bleed product rail.

  Cards run edge to edge with only a hairline between them, so the row reads as
  one continuous strip and the last card is deliberately cut off to signal that
  it scrolls. Each card carries a tag-driven badge, a wishlist heart, an add to
  cart that appears on hover, and the colour swatches for its options.
{% endcomment %}

{{ 'editorial.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
<script src="{{ 'editorial.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  if s.show_quick_add
    assign needs_product_form = true
  endif

  comment
    Rail items are a fixed proportion of the viewport, so the sizes hint is too.
  endcomment
  assign card_sizes = '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 62vw'
-%}

{%- if needs_product_form -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="color-{{ s.color_scheme }} gradient ed-railstrip">
  {%- if s.heading != blank or s.view_all_label != blank -%}
    <div class="ed-width ed-railstrip__head">
      {%- if s.heading != blank -%}
        <h2 class="ed-display ed-display--sm ed-reveal">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.view_all_label != blank and s.collection != blank -%}
        <a href="{{ s.collection.url }}" class="ed-link">
          {{ s.view_all_label | escape }}
          <span class="ed-link__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="ed-rail ed-rail--flush" role="list">
    {%- for product in s.collection.products limit: s.products_to_show -%}
      <li class="ed-rail__item">
        {%- render 'editorial-card',
          card_product: product,
          ratio: s.image_ratio,
          card_sizes: card_sizes,
          show_second_image: s.show_second_image,
          show_quick_add: s.show_quick_add,
          show_swatches: s.show_swatches,
          badge_prefix: s.badge_prefix,
          card_modifier: 'ed-product--rail',
          card_section_id: section.id,
          card_index: forloop.index0
        -%}
      </li>
    {%- else -%}
      {%- comment -%} Nothing chosen yet: show the shape, not an error. {%- endcomment -%}
      {%- for i in (1..6) -%}
        <li class="ed-rail__item">
          <div class="ed-product ed-product--rail">
            <div class="ed-product__media" style="--ed-ratio: {{ s.image_ratio }};">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
            <div class="ed-product__info">
              <h3 class="ed-product__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="ed-product__price">{{ 1990 | money }}</div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Product rail",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Finish the look",
      "label": "Heading"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "2 / 3", "label": "Tall" },
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "2 / 3",
      "label": "Image shape"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "default": true,
      "label": "Fade to the second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "default": true,
      "label": "Show add to cart on hover",
      "info": "Products with options link to the product page instead."
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "default": true,
      "label": "Show colour swatches",
      "info": "Uses the product's Color option. Set swatch colours in Shopify under the option's values."
    },
    {
      "type": "text",
      "id": "badge_prefix",
      "default": "badge:",
      "label": "Badge tag prefix",
      "info": "A product tagged \"badge:New In\" shows a New In badge. Leave blank for no badges."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "default": "View all",
      "label": "View all label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
