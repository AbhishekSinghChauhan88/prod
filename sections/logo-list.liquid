{{ 'theme-sections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #LogoList-{{ section.id }} img {
    max-height: {{ section.settings.logo_height | times: 0.8 | round: 0 }}px;
    width: auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #LogoList-{{ section.id }} img {
      max-height: {{ section.settings.logo_height }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign duration = 60 | minus: section.settings.speed | times: 1.2 | at_least: 10
  assign list_class = 'logo-list logo-list--' | append: section.settings.columns_desktop
  if section.settings.grayscale
    assign list_class = list_class | append: ' logo-list--grayscale'
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient" id="LogoList-{{ section.id }}">
  <div class="{% unless section.settings.enable_marquee %}page-width{% endunless %} section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title {{ section.settings.heading_size }} center{% if section.settings.enable_marquee %} page-width{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.enable_marquee -%}
      <scrolling-marquee
        class="marquee"
        style="--marquee-duration: {{ duration }}s; --marquee-hover-state: paused;"
      >
        <div class="marquee__track">
          <div class="marquee__group">
            {%- for block in section.blocks -%}
              <span class="marquee__item{% if section.settings.grayscale %} logo-list--grayscale{% endif %}" {{ block.shopify_attributes }}>
                {%- render 'logo-list-item', block: block -%}
              </span>
            {%- endfor -%}
          </div>
        </div>
      </scrolling-marquee>
    {%- else -%}
      <ul class="{{ list_class }}" role="list">
        {%- for block in section.blocks -%}
          <li
            class="logo-list__item{% if section.settings.animate %} scroll-trigger animate--fade-in{% endif %}"
            {% if section.settings.animate %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- render 'logo-list-item', block: block -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "As seen in",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "Extra small"
        },
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        }
      ],
      "default": "h3",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "Maximum logo height"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "default": true,
      "label": "Fade logos until hovered"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "default": false,
      "label": "Scroll logos continuously"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 55,
      "step": 5,
      "default": 20,
      "label": "Scroll speed"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "default": false,
      "label": "Animate on scroll"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Used as the image alt text when the logo has none."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
