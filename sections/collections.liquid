{% comment %}
  Collections — a small number of large image tiles.

  One block per collection. The image is the element; the name is a quiet
  caption, set either beneath the image or over its foot.
{% endcomment %}

{{ 'editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'editorial.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
-%}

<div class="color-{{ s.color_scheme }} gradient">
  <div class="ed-width ed-section">
    {%- if s.heading != blank or s.label != blank -%}
      <div class="ed-section__head ed-section__head--{{ s.text_alignment }} ed-reveal">
        {%- if s.label != blank -%}
          <p class="ed-label">{{ s.label | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="ed-display ed-display--sm">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="ed-tiles" role="list" style="--ed-columns: {{ section.blocks.size | at_most: 3 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tile_name = block.settings.title | default: collection.title
          assign tile_url = collection.url | default: routes.all_products_collection_url
          assign tile_image = block.settings.image | default: collection.featured_image
        -%}
        <li
          class="ed-tile{% if s.caption_position == 'overlay' %} ed-tile--overlay{% endif %} ed-reveal"
          style="--ed-delay: {{ forloop.index0 | times: 90 }}ms;"
          {{ block.shopify_attributes }}
        >
          <div class="ed-tile__media" style="--ed-ratio: {{ s.image_ratio }};">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 1800
                | image_tag:
                  widths: '400, 600, 800, 1100, 1400, 1800',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: tile_image.alt | default: tile_name
              }}
            {%- else -%}
              {%- assign ph = 'collection-' | append: forloop.index -%}
              {{ ph | placeholder_svg_tag }}
            {%- endif -%}
          </div>

          <div class="ed-tile__body">
            <h3 class="ed-tile__name">
              <a href="{{ tile_url }}">{{ tile_name | escape }}</a>
            </h3>
            {%- if block.settings.cta_label != blank -%}
              <span class="ed-label" aria-hidden="true">{{ block.settings.cta_label | escape }} &rarr;</span>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Collections",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Tall" }
      ],
      "default": "4 / 5",
      "label": "Image shape"
    },
    {
      "type": "select",
      "id": "caption_position",
      "options": [
        { "value": "below", "label": "Below the image" },
        { "value": "overlay", "label": "Over the image" }
      ],
      "default": "below",
      "label": "Caption position"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Falls back to the collection's own image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional. Falls back to the collection's name."
        },
        { "type": "text", "id": "cta_label", "default": "Shop", "label": "Link label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections",
      "blocks": [{ "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
